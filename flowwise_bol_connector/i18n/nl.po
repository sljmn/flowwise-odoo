#. module: flowwise_bol_connector
#: model:ir.model.fields,field_description:flowwise_bol_connector.field_bol_price
msgid "Bol.com price"
msgstr "Bol.com-prijs"

#. module: flowwise_bol_connector
#: model:ir.model.fields,help:flowwise_bol_connector.field_bol_price
msgid "The price with VAT for this product on bol.com. Flowwise sends it as it is, instead of the price from your sales price and price rules. Leave it empty to use those."
msgstr "De prijs met btw van dit product op bol.com. Flowwise stuurt hem zo door, in plaats van de prijs uit je verkoopprijs en prijsregels. Laat hem leeg om die te gebruiken."

#. module: flowwise_bol_connector
#: model:ir.model.fields,field_description:flowwise_bol_connector.field_bol_delivery_code
msgid "Bol.com delivery time"
msgstr "Bol.com-levertijd"

#. module: flowwise_bol_connector
#: model:ir.model.fields,help:flowwise_bol_connector.field_bol_delivery_code
msgid "The delivery time Flowwise sends to bol.com for this product. Leave it empty to use the delivery time you set in Flowwise."
msgstr "De levertijd die Flowwise voor dit product naar bol.com stuurt. Laat hem leeg om de levertijd uit Flowwise te gebruiken."

#. module: flowwise_bol_connector
#: model_terms:ir.ui.view,arch_db:flowwise_bol_connector.product_template_form_bol
msgid "Bol.com"
msgstr "Bol.com"

#. module: flowwise_bol_connector
#: model_terms:ir.ui.view,arch_db:flowwise_bol_connector.product_template_form_bol
msgid "Flowwise sends these values to the bol.com offer with the same EAN as the Barcode of this product. Leave a field empty to use your settings in Flowwise."
msgstr "Flowwise stuurt deze waarden naar de bol.com-aanbieding met dezelfde EAN als de barcode van dit product. Laat een veld leeg om je instellingen in Flowwise te gebruiken."

