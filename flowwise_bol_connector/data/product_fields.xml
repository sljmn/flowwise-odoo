<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Flowwise reads these fields with the Odoo API and sends their values to the bol.com offer with the same EAN. -->
    <record id="field_bol_price" model="ir.model.fields">
        <field name="model_id" ref="product.model_product_template"/>
        <field name="name">x_flowwise_bol_price</field>
        <field name="field_description">Bol.com price</field>
        <field name="help">The price with VAT for this product on bol.com. Flowwise sends it as it is, instead of the price from your sales price and price rules. Leave it empty to use those.</field>
        <field name="ttype">float</field>
        <field name="state">manual</field>
        <field name="store" eval="True"/>
    </record>

    <record id="field_bol_delivery_code" model="ir.model.fields">
        <field name="model_id" ref="product.model_product_template"/>
        <field name="name">x_flowwise_bol_delivery_code</field>
        <field name="field_description">Bol.com delivery time</field>
        <field name="help">The delivery time Flowwise sends to bol.com for this product. Leave it empty to use the delivery time you set in Flowwise.</field>
        <field name="ttype">selection</field>
        <field name="state">manual</field>
        <field name="store" eval="True"/>
    </record>

    <record id="selection_delivery_vvb" model="ir.model.fields.selection">
        <field name="field_id" ref="field_bol_delivery_code"/>
        <field name="value">VVB</field>
        <field name="name">Shipped via bol.com (VVB)</field>
        <field name="sequence">0</field>
    </record>
    <record id="selection_delivery_my_delivery_promise" model="ir.model.fields.selection">
        <field name="field_id" ref="field_bol_delivery_code"/>
        <field name="value">MY_DELIVERY_PROMISE</field>
        <field name="name">My delivery promise</field>
        <field name="sequence">1</field>
    </record>
    <record id="selection_delivery_1_2d" model="ir.model.fields.selection">
        <field name="field_id" ref="field_bol_delivery_code"/>
